{
  "extends": ["next/core-web-vitals", "next/typescript"],
  "rules": {
    "eslint-plugin-vue/no-unused-emit-declarations": "off", // Disable the rule
    
    "no-unused-vars": "off", // Completely disable the rule
    "@typescript-eslint/no-explicit-any": "off", // Allow the use of 'any' type
    "no-console": "warn", // Warn for console logs, but don't treat as an error
    "no-debugger": "warn" // Warn for debugger usage, but don't treat as an error
  }
}
