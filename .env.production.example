# Next.js Frontend Production Environment Configuration

# NextAuth / Auth.js configuration
# Generate secret with: openssl rand -base64 33
AUTH_SECRET=your-random-32-character-secret
NEXTAUTH_URL=https://yourdomain.com
AUTH_URL=https://yourdomain.com

# Google OAuth Credentials (configured in Google Cloud Console)
# Authorized redirect URI: https://yourdomain.com/api/auth/callback/google
AUTH_GOOGLE_ID=your-google-client-id.apps.googleusercontent.com
AUTH_GOOGLE_SECRET=your-google-client-secret

# Public Backend Endpoints
# Replace 'https://api.yourdomain.com' with your backend domain or 'http://<VPS_IP>:8000'
NEXT_PUBLIC_API_URL=https://api.yourdomain.com/
NEXT_PUBLIC_LOGIN_URL=https://api.yourdomain.com/login/
NEXT_PUBLIC_REGISTER_URL=https://api.yourdomain.com/users/register/
NEXT_PUBLIC_PROBLEMS_URL=https://api.yourdomain.com/problems/
NEXT_PUBLIC_PROBLEM_LIST_URL=https://api.yourdomain.com/problems/
NEXT_PUBLIC_PROBLEMDETAILS_URL=https://api.yourdomain.com/pbs/
NEXT_PUBLIC_RUNCODE_URL=https://api.yourdomain.com/runcode/
NEXT_PUBLIC_TESTCASE_URL=https://api.yourdomain.com/testcases/
NEXT_PUBLIC_CONTESTS_URL=https://api.yourdomain.com/contestlist/
NEXT_PUBLIC_CONTESTDETAIL_URL=https://api.yourdomain.com/contestdetail/
NEXT_PUBLIC_JOINCONTEST_URL=https://api.yourdomain.com/joincontest/
NEXT_PUBLIC_SUBMITCONTESTPROBLEM_URL=https://api.yourdomain.com/submitcontestproblem/
